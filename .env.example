# Google Gemini API Key for MCP Client
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Model name configuration (optional, defaults to gemini-3.1-flash-lite)
# Supported models: gemini-2.0-flash, gemini-3.1-flash-lite, etc.
GEMINI_MODEL="gemini-3.1-flash-lite"
